PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=app_db

# Trazabilidad (src/observability)
# Log JSON por petición con traceId, duración y spans
TRACE_LOG=true
# Expone GET /api/traces y /api/traces/stats (apagar en producción)
TRACE_ENDPOINT=true
# Cuántas trazas recientes se guardan en memoria
TRACE_BUFFER_SIZE=500
# Peticiones más lentas que esto salen con level "warn"
TRACE_SLOW_MS=200
